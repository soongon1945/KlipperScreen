[Unit]
Description=KlipperScreen
StartLimitIntervalSec=0
# Start X while Plymouth still owns the final frame, then allow the normal
# quit units to run only after X has painted its replacement frame.
After=systemd-user-sessions.service plymouth-start.service
Before=plymouth-quit.service plymouth-quit-wait.service
# On systems without virtual consoles, do not start.
ConditionPathExists=/dev/tty0
# D-Bus is necessary for contacting logind, which is required.
Wants=dbus.socket systemd-logind.service
After=dbus.socket systemd-logind.service
After=moonraker.service

[Service]
Type=simple
Restart=always
RestartSec=2
User=KS_USER
SupplementaryGroups=klipperscreen
# Keep the display client's runtime files independent of transient login
# sessions; an SSH logout must not terminate Xorg and blank the touchscreen.
RuntimeDirectory=klipperscreen
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/klipperscreen
WorkingDirectory=KS_DIR
Environment="KS_XCLIENT=KS_ENV/bin/python KS_DIR/screen.py" BACKEND=KS_BACKEND
# Debian Plymouth 24 can crash in libply-splash-core when quit uses
# --retain-splash.  Deactivate releases DRM while preserving the framebuffer;
# the normal quit runs after KlipperScreen reports that X is ready.
ExecStartPre=-/usr/bin/plymouth deactivate
ExecStart="KS_DIR/scripts/KlipperScreen-start.sh"
ExecStartPost="KS_DIR/scripts/KlipperScreen-wait-display-ready.sh"

# Log this user with utmp, letting it show up with commands 'w' and
# 'who'. This is needed since we replace (a)getty.
UtmpIdentifier=tty7
UtmpMode=user
# Create a PAM session to run pam-systemd, which creates /var/run/$UID
PAMName=%u
# A virtual terminal is needed.
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
